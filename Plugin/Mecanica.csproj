<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mod Mecanica (pistao + bearing) para Approximately Up. Build pelo Unity (Modkit > Mods), por `modkit build`,
       ou na mao com -p:"ModkitGameDir=/caminho/Approximately Up". -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Mecanica</AssemblyName>
    <ModDisplayName>Crap Mechanics</ModDisplayName>
    <RootNamespace>Mecanica</RootNamespace>
    <Version>0.23.2</Version>
    <Authors>Andre + Claude</Authors>
    <Description>Crap Mechanics: pistons, bearings, motors, wheels, recoupler, beacon, turret seat and more for Approximately Up.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BaseOutputPath>bin~\</BaseOutputPath>
    <RestoreOutputPath>obj~\</RestoreOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <NoWarn>CS0168;CS0219;CS8632</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ModkitGameDir Condition="'$(ModkitGameDir)' == ''">$(MODKIT_GAME_DIR)</ModkitGameDir>
    <ModkitBepInExCoreDir Condition="'$(ModkitBepInExCoreDir)' == '' and '$(ModkitGameDir)' != ''">$(ModkitGameDir)/BepInEx/core</ModkitBepInExCoreDir>
    <ModkitInteropDir Condition="'$(ModkitInteropDir)' == '' and '$(ModkitGameDir)' != ''">$(ModkitGameDir)/BepInEx/interop</ModkitInteropDir>
    <!-- ComponentsFramework.dll: do jogo (plugins/ComponentsFramework) ou de uma pasta passada em -p:CFDir= -->
    <CFDir Condition="'$(CFDir)' == '' and '$(ModkitGameDir)' != ''">$(ModkitGameDir)/BepInEx/plugins/ComponentsFramework</CFDir>
  </PropertyGroup>

  <Target Name="ModkitCheckReferences" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ModkitGameDir)' == '' and '$(ModkitInteropDir)' == ''"
           Text="Nothing said where the game is. Build this mod from the Unity editor (Modkit &gt; Mods), with `modkit build`, or pass -p:&quot;ModkitGameDir=&lt;the folder holding GameAssembly.dll&gt;&quot;." />
    <Error Condition="!Exists('$(ModkitInteropDir)')" Text="No interop assemblies at $(ModkitInteropDir)." />
    <Error Condition="!Exists('$(CFDir)/ComponentsFramework.dll')" Text="ComponentsFramework.dll nao achado em $(CFDir) (instala o Components Framework em BepInEx/plugins/ComponentsFramework)." />
  </Target>

  <ItemGroup Condition="Exists('$(ModkitInteropDir)')">
    <Reference Include="$(ModkitBepInExCoreDir)/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/0Harmony.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(ModkitBepInExCoreDir)/Il2CppInterop.HarmonySupport.dll" Private="false" />
    <Reference Include="$(ModkitInteropDir)/*.dll" Private="false" />
    <Reference Include="$(CFDir)/ComponentsFramework.dll" Private="false" />
  </ItemGroup>

  <!-- O Components Framework le o Localization.json da pasta do plugin no jogo; o `modkit build` so poe dll+pdb em dist~ -->
  <Target Name="ModkitPublishLocalization" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/Localization.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Localization.json" DestinationFolder="$(MSBuildProjectDirectory)/../dist~/" SkipUnchangedFiles="true" />
  </Target>

</Project>
